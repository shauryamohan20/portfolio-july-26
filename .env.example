# Copy to .env.local for local use, or set these in your host's dashboard.
# Never commit real values — .env* is gitignored.

# --- Admin login -------------------------------------------------------------
# Both must be set for the admin panel to exist on a deployed site.
# Without them the panel is local-development-only and returns 404 in production.

# A long passphrase. Use something only you know; this is the only thing
# standing between the internet and your site's content.
ADMIN_PASSWORD=

# 32+ characters used to sign the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- Saving online -----------------------------------------------------------
# Only needed on the deployed site. Left unset (locally), saves write straight
# to data/projects.json on disk.
#
# Create a fine-grained personal access token at
# https://github.com/settings/personal-access-tokens
# scoped to this one repository, with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=shauryamohan20/portfolio-july-26
GITHUB_BRANCH=main

# --- Kill switch -------------------------------------------------------------
# Set to false to turn the admin panel off everywhere, regardless of the above.
# ENABLE_ADMIN=false
